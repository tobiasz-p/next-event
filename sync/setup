#!/usr/bin/env bash
# Interactive onboarding for Google Calendar sync using `gum`.
#
# Default CLI is `gws` (Google Workspace CLI) with a guided GCP OAuth setup.
# `gog` is optional when installed. Pin with NEXT_EVENT_CLI=gws|gog, or a
# one-line `cli` file in the profile directory.

set -euo pipefail

if ! command -v gum >/dev/null 2>&1; then
  echo "Error: 'gum' is required for NextEvent setup." >&2
  echo "Install it via your package manager (e.g. pacman -S gum)." >&2
  exit 1
fi

PROJECT_ID="${PROJECT_ID:-}"
PROFILE="${PROFILE:-$HOME/.config/gws-omarchy-calendar}"
GCLOUD_CONFIG="${GCLOUD_CONFIG:-next-event}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SYNC_BIN="$SCRIPT_DIR/next-event-sync"
SCOPE="https://www.googleapis.com/auth/calendar.readonly"
GOG_ACCOUNT="${NEXT_EVENT_GOG_ACCOUNT:-}"
CLI="${NEXT_EVENT_CLI:-}"

banner() {
  gum style \
    --foreground 99 --border-foreground 99 --border double \
    --align center --width 64 --margin "1 0" --padding "1 2" \
    "NextEvent — Google Calendar OAuth Setup" \
    "Connect Google Workspace & Private Calendars"
}

step_header() {
  printf '\n'
  gum style --foreground 39 --bold "[$1] $2"
}

info() {
  gum style --foreground 245 "    $1"
}

success() {
  gum style --foreground 48 "  ✓ $1"
}

warn() {
  gum style --foreground 214 "  ! $1"
}

open_url() {
  local url="$1"
  if command -v xdg-open >/dev/null 2>&1; then
    (nohup xdg-open "$url" </dev/null >/dev/null 2>&1 &)
  elif command -v open >/dev/null 2>&1; then
    (nohup open "$url" </dev/null >/dev/null 2>&1 &)
  fi
}

pause_step() {
  local prompt="${1:-Press Enter to continue}"
  if [ -t 0 ]; then
    printf '\n'
    gum style --foreground 212 --bold "❯ $prompt"
    read -r _ || true
  fi
}

gog_cmd() {
  if [ -n "$GOG_ACCOUNT" ]; then
    gog --account "$GOG_ACCOUNT" "$@"
  else
    gog "$@"
  fi
}

list_calendars_json() {
  if [ "$CLI" = "gog" ]; then
    gog_cmd calendar calendars --json --no-input --all 2>/dev/null || echo '{"calendars":[]}'
  else
    gws calendar calendarList list 2>/dev/null || echo '{"items":[]}'
  fi
}

persist_cli() {
  mkdir -p "$PROFILE"
  chmod 700 "$PROFILE"
  printf '%s\n' "$CLI" > "$PROFILE/cli"
  export NEXT_EVENT_CLI="$CLI"
  if [ "$CLI" = "gws" ]; then
    export GOOGLE_WORKSPACE_CLI_CONFIG_DIR="$PROFILE"
  fi
}

resolve_cli() {
  if [ "$CLI" = "auto" ]; then
    CLI=""
  fi
  if [ -z "$CLI" ] && [ -f "$PROFILE/cli" ]; then
    CLI=$(tr -d '[:space:]' < "$PROFILE/cli")
  fi
  if [ "$CLI" = "auto" ]; then
    CLI=""
  fi

  local has_gws=0 has_gog=0
  command -v gws >/dev/null 2>&1 && has_gws=1
  command -v gog >/dev/null 2>&1 && has_gog=1

  if [ -n "$CLI" ]; then
    case "$CLI" in
      gws|gog) ;;
      *)
        echo "Error: NEXT_EVENT_CLI must be gws or gog (got '$CLI')." >&2
        exit 1
        ;;
    esac
    if ! command -v "$CLI" >/dev/null 2>&1; then
      echo "Error: NEXT_EVENT_CLI=$CLI but '$CLI' is not on PATH." >&2
      exit 1
    fi
    persist_cli
    return
  fi

  if [ "$has_gws" -eq 1 ] && [ "$has_gog" -eq 1 ]; then
    CLI=$(printf '%s\n' gws gog | gum choose --selected=gws --header="Google Calendar CLI (gws is the default)")
  elif [ "$has_gws" -eq 1 ]; then
    CLI=gws
  elif [ "$has_gog" -eq 1 ]; then
    CLI=gog
    info "gws is not installed; using optional gog CLI."
  else
    warn "No Google Calendar CLI found."
    gum style --foreground 214 --border rounded --padding "0 1" \
      "Install the default CLI (gws):" \
      "  npm install -g @googleworkspace/cli" \
      "  https://github.com/googleworkspace/cli" \
      "" \
      "Or the optional CLI (gog):" \
      "  gog auth setup && gog auth add <your-email>" \
      "  https://github.com/openclaw/gogcli"
    exit 1
  fi
  persist_cli
}

cli_is_ready() {
  if [ "$CLI" = "gog" ]; then
    gog_cmd calendar calendars --json --no-input --max 1 >/dev/null 2>&1
  else
    [ -f "$PROFILE/client_secret.json" ] && gws auth print-access-token >/dev/null 2>&1
  fi
}

install_systemd() {
  local systemd_user_dir="$HOME/.config/systemd/user"
  local systemd_src="$SCRIPT_DIR/systemd"
  mkdir -p "$systemd_user_dir"

  sed \
    -e "s|%h/.config/omarchy/plugins/tobiasz-p.next-event/sync/next-event-sync|$SYNC_BIN|g" \
    -e "s|%h/.config/gws-omarchy-calendar|$PROFILE|g" \
    -e "s|%h/.local/state/omarchy|$HOME/.local/state/omarchy|g" \
    -e "s|NEXT_EVENT_CLI=auto|NEXT_EVENT_CLI=$CLI|g" \
    -e "s|NEXT_EVENT_GOG_ACCOUNT=|NEXT_EVENT_GOG_ACCOUNT=$GOG_ACCOUNT|g" \
    "$systemd_src/next-event-sync.service" \
    > "$systemd_user_dir/next-event-sync.service"

  cp "$systemd_src/next-event-sync.timer" "$systemd_user_dir/next-event-sync.timer"

  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user enable --now next-event-sync.timer 2>/dev/null || true
    success "Enabled systemd user timer (next-event-sync.timer)"
  fi

  if command -v omarchy >/dev/null 2>&1; then
    omarchy bar set tobiasz-p.next-event icsUrl "" 2>/dev/null || true
  fi
}

chmod +x "$SYNC_BIN" 2>/dev/null || true

select_calendars() {
  step_header "1/2" "Querying Google Calendars"

  info "Fetching calendars from your account ($CLI)..."
  local cal_list_raw
  cal_list_raw=$(list_calendars_json)

  CAL_NAMES=()
  CAL_IDS=()

  while IFS=$'\t' read -r cid summary is_primary is_selected; do
    if [ -n "$cid" ]; then
      label="$summary"
      if [ "$is_primary" = "True" ] || [ "$is_primary" = "true" ]; then
        label="$label (Primary)"
      fi
      CAL_NAMES+=("$label")
      CAL_IDS+=("$cid")
    fi
  done < <(python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
except Exception:
    raise SystemExit(0)
items = data if isinstance(data, list) else (
    data.get('items') or data.get('calendars') or []
)
for c in items:
    print(f\"{c.get('id', '')}\t{c.get('summary', '')}\t{c.get('primary', False)}\t{c.get('selected', True)}\")
" <<< "$cal_list_raw")

  if [ "${#CAL_NAMES[@]}" -eq 0 ]; then
    warn "No calendars found or not authenticated."
    info "Run full setup to authenticate first: $0"
    exit 1
  fi

  step_header "2/2" "Choose Calendars to Sync"
  info "Use Space to toggle checkboxes, Enter to save:"

  PRESELECTED=""
  if [ -f "$PROFILE/calendars.txt" ]; then
    CURRENT_ACTIVE=$(grep -v '^#' "$PROFILE/calendars.txt" | grep -v '^[[:space:]]*$' || true)
    PRE_LIST=()
    for i in "${!CAL_NAMES[@]}"; do
      if echo "$CURRENT_ACTIVE" | grep -qF "${CAL_IDS[$i]}"; then
        PRE_LIST+=("${CAL_NAMES[$i]}")
      fi
    done
    if [ "${#PRE_LIST[@]}" -gt 0 ]; then
      PRESELECTED=$(IFS=,; echo "${PRE_LIST[*]}")
    fi
  else
    # Default on initial setup: pre-select the Primary calendar
    PRE_LIST=()
    for i in "${!CAL_NAMES[@]}"; do
      if [[ "${CAL_NAMES[$i]}" == *"(Primary)"* ]]; then
        PRE_LIST+=("${CAL_NAMES[$i]}")
      fi
    done
    if [ "${#PRE_LIST[@]}" -gt 0 ]; then
      PRESELECTED=$(IFS=,; echo "${PRE_LIST[*]}")
    fi
  fi

  if [ -n "$PRESELECTED" ]; then
    SELECTED_CHOICES=$(printf '%s\n' "${CAL_NAMES[@]}" | gum choose --no-limit --cursor-prefix="[ ] " --selected-prefix="[✓] " --unselected-prefix="[ ] " --selected="$PRESELECTED" || true)
  else
    SELECTED_CHOICES=$(printf '%s\n' "${CAL_NAMES[@]}" | gum choose --no-limit --cursor-prefix="[ ] " --selected-prefix="[✓] " --unselected-prefix="[ ] " || true)
  fi

  if [ -n "$SELECTED_CHOICES" ]; then
    > "$PROFILE/calendars.txt"
    while IFS= read -r choice; do
      for i in "${!CAL_NAMES[@]}"; do
        if [ "${CAL_NAMES[$i]}" = "$choice" ]; then
          echo "${CAL_IDS[$i]}" >> "$PROFILE/calendars.txt"
          break
        fi
      done
    done <<< "$SELECTED_CHOICES"
    success "Saved calendar selection to $PROFILE/calendars.txt"
  else
    rm -f "$PROFILE/calendars.txt"
    info "No specific filter selected — syncing all active calendars."
  fi

  printf '\n'
  gum spin --spinner dot --title "Syncing calendar events..." -- \
    env NEXT_EVENT_CLI="$CLI" NEXT_EVENT_PROFILE="$PROFILE" "$SYNC_BIN"
  success "Synced events into ~/.local/state/omarchy/calendar-events.json"

  gum style \
    --foreground 48 --border-foreground 48 --border rounded \
    --align center --width 64 --margin "1 0" --padding "1 2" \
    "✓ Calendar Selection Updated!" \
    "" \
    "Events are refreshed in ~/.local/state/omarchy/calendar-events.json"
}

setup_gog() {
  step_header "1/2" "Checking gog"

  local ver
  ver=$(gog --version 2>/dev/null | head -n 1 || echo 'ok')
  success "Found gog CLI ($ver)"

  step_header "2/2" "Google Calendar access"

  if gog_cmd calendar calendars --json --no-input --max 1 >/dev/null 2>&1; then
    success "gog is authenticated and can list calendars"
  else
    warn "gog is installed but cannot list calendars yet."
    gum style --border rounded --border-foreground 39 --padding "1 2" --width 66 \
      "Authenticate gog in a terminal:" \
      "" \
      "  gog auth setup" \
      "  gog auth add <your-email>" \
      "" \
      "Then re-run this setup script."
    exit 1
  fi

  select_calendars
  install_systemd
}

setup_gws() {
  gum style --foreground 252 --width 64 \
    "Google Workspace organizations often disable private .ics feeds." \
    "This tool connects your Google Calendar via OAuth using your own" \
    "Google Cloud project so tokens never expire and your data stays private."

  # 1. Check prerequisites
  step_header "1/6" "Checking prerequisites"

  local gws_ver
  gws_ver=$(gws --version 2>/dev/null | head -n 1 || echo 'ok')
  success "Found gws CLI ($gws_ver)"

  mkdir -p "$PROFILE"
  chmod 700 "$PROFILE"

  # 2. Check gcloud or manual project creation
  step_header "2/6" "Google Cloud Project Configuration"

  if command -v gcloud >/dev/null 2>&1; then
    info "Using isolated gcloud configuration '$GCLOUD_CONFIG'..."
    gcloud config configurations describe "$GCLOUD_CONFIG" >/dev/null 2>&1 \
      || gcloud config configurations create "$GCLOUD_CONFIG" --no-activate
    export CLOUDSDK_ACTIVE_CONFIG_NAME="$GCLOUD_CONFIG"

    CURRENT_ACC=$(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null | head -n1)
    if [ -n "$CURRENT_ACC" ]; then
      success "Signed in to gcloud as: $CURRENT_ACC"
    else
      info "Signing in to Google Cloud CLI..."
      gcloud auth login
    fi

    if [ -z "$PROJECT_ID" ]; then
      PROJECT_ID=$(gcloud projects list --filter="projectId ~ ^nextevent-cal" --format='value(projectId)' --limit=1 2>/dev/null || true)
      if [ -z "$PROJECT_ID" ]; then
        PROJECT_ID="nextevent-cal-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
        info "Creating GCP project: $PROJECT_ID..."
        gcloud projects create "$PROJECT_ID" --name="NextEvent Calendar" >/dev/null 2>&1 || true
      else
        info "Reusing existing GCP project: $PROJECT_ID"
      fi
    fi

    gcloud config set project "$PROJECT_ID" >/dev/null 2>&1 || true
    info "Enabling Google Calendar API on project $PROJECT_ID..."
    gcloud services enable calendar-json.googleapis.com --project="$PROJECT_ID" >/dev/null 2>&1 || true
    success "Google Calendar API enabled on $PROJECT_ID"
  else
    info "gcloud CLI not found (skipping automated project creation)."
    info "You can create a project manually at: https://console.cloud.google.com/projectcreate"
  fi

  # 3. Google Cloud Console manual steps
  step_header "3/6" "Configure OAuth in Google Cloud Console"

  CONSENT_URL="https://console.cloud.google.com/apis/credentials/consent"
  CLIENT_URL="https://console.cloud.google.com/apis/credentials/oauthclient"

  gum style --border rounded --border-foreground 39 --padding "1 2" --width 66 \
    "Google Cloud Console Steps:" \
    "" \
    "1. OAuth Consent Screen / Data Access ($CONSENT_URL)" \
    "   • User Type: External (or Internal for Workspace)" \
    "   • App Name: NextEvent (enter support email)" \
    "   • Under 'Manually add scopes', paste:" \
    "     https://www.googleapis.com/auth/calendar.readonly" \
    "     Click 'Add to table' -> 'Update' -> 'Save and continue'" \
    "   • Audience: Click 'PUBLISH APP' (so tokens don't expire after 7 days)" \
    "" \
    "2. Desktop OAuth Client ($CLIENT_URL)" \
    "   • Application Type: Desktop App" \
    "   • Name: NextEvent Client" \
    "   • Click 'Create' -> Click 'Download JSON' to save to ~/Downloads"

  if gum confirm --default=true "Open Google Cloud Console in your browser?"; then
    open_url "$CONSENT_URL"
  fi

  pause_step "Press Enter once you have downloaded the client secret JSON file to continue..."

  # 4. Ingest client credentials
  step_header "4/6" "Importing Client Credentials"

  CLIENT_SECRET_FILE="$PROFILE/client_secret.json"
  SECRET_IMPORTED=false

  AUTO_SECRET=$(find "$HOME/Downloads" -maxdepth 1 -name "client_secret_*.json" -type f 2>/dev/null | head -n 1 || true)

  if [ -f "$CLIENT_SECRET_FILE" ]; then
    success "Found existing credentials file at $CLIENT_SECRET_FILE"
    if gum confirm --default=true "Use existing credentials in $CLIENT_SECRET_FILE?"; then
      SECRET_IMPORTED=true
    fi
  fi

  if [ "$SECRET_IMPORTED" = false ] && [ -n "$AUTO_SECRET" ] && [ -f "$AUTO_SECRET" ]; then
    if gum confirm --default=true "Found client secret at '$AUTO_SECRET'. Use it?"; then
      cp "$AUTO_SECRET" "$CLIENT_SECRET_FILE"
      chmod 600 "$CLIENT_SECRET_FILE"
      success "Imported $AUTO_SECRET"
      SECRET_IMPORTED=true
    fi
  fi

  if [ "$SECRET_IMPORTED" = false ]; then
    METHOD=$(gum choose "Browse / Select JSON file" "Enter file path" "Enter Client ID & Secret manually")

    case "$METHOD" in
      "Browse / Select JSON file")
        SELECTED_FILE=$(gum file "$HOME/Downloads" --file || true)
        if [ -n "$SELECTED_FILE" ] && [ -f "$SELECTED_FILE" ]; then
          cp "$SELECTED_FILE" "$CLIENT_SECRET_FILE"
          chmod 600 "$CLIENT_SECRET_FILE"
          success "Imported credentials from $SELECTED_FILE"
          SECRET_IMPORTED=true
        fi
        ;;

      "Enter file path")
        INPUT_PATH=$(gum input --placeholder "Path to client_secret_*.json (e.g. ~/Downloads/client_secret.json)" --width 60)
        # Expand tilde safely without eval
        INPUT_PATH="${INPUT_PATH/#\~/$HOME}"
        if [ -n "$INPUT_PATH" ] && [ -f "$INPUT_PATH" ]; then
          cp "$INPUT_PATH" "$CLIENT_SECRET_FILE"
          chmod 600 "$CLIENT_SECRET_FILE"
          success "Imported $INPUT_PATH"
          SECRET_IMPORTED=true
        else
          warn "File not found at $INPUT_PATH"
        fi
        ;;

      *)
        # "Enter Client ID & Secret manually"
        info "Enter your OAuth Client credentials manually:"
        CLIENT_ID=$(gum input --placeholder "OAuth Client ID (e.g. xxxx.apps.googleusercontent.com)" --width 60)
        CLIENT_SECRET=$(gum input --password --placeholder "OAuth Client Secret" --width 60)
        cat > "$CLIENT_SECRET_FILE" <<JSONEOF
{"installed":{"client_id":"$CLIENT_ID","client_secret":"$CLIENT_SECRET","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}}
JSONEOF
        chmod 600 "$CLIENT_SECRET_FILE"
        success "Saved credentials to $CLIENT_SECRET_FILE"
        ;;
    esac
  fi

  # 5. Authenticate via gws
  step_header "5/6" "OAuth Login via Browser"

  info "Opening browser for Google Workspace authentication..."
  gws auth login --scopes="$SCOPE"

  success "Authentication successful!"

  # 6. Choose calendars to sync
  select_calendars
  install_systemd
}

banner
resolve_cli

# If invoked with --calendars or calendars, jump straight to calendar selection
if [ "${1:-}" = "--calendars" ] || [ "${1:-}" = "calendars" ] || [ "${1:-}" = "-c" ]; then
  select_calendars
  exit 0
fi

# If existing authentication is present, offer quick calendar selection vs full re-auth
if cli_is_ready; then
  gum style --foreground 252 \
    "Existing Google Calendar authentication found ($CLI)."
  ACTION=$(gum choose "Select / Change calendars to sync" "Re-run full OAuth setup from scratch")
  if [ "$ACTION" = "Select / Change calendars to sync" ]; then
    select_calendars
    exit 0
  fi
fi

if [ "$CLI" = "gog" ]; then
  setup_gog
else
  setup_gws
fi

gum style \
  --foreground 48 --border-foreground 48 --border rounded \
  --align center --width 64 --margin "1 0" --padding "1 2" \
  "✓ NextEvent Setup Complete!" \
  "" \
  "Events are synced to ~/.local/state/omarchy/calendar-events.json" \
  "Automatic background sync runs every 5 minutes ($CLI)." \
  "NextEvent in your Omarchy bar is ready!"
