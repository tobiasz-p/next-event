#!/usr/bin/env python3
"""
NextEvent — Google Calendar Sync Runner
Fetches Google Calendar events using `gws` (default) or `gog`, normalizes them
to the Omarchy calendar-events contract, and writes atomically to
~/.local/state/omarchy/calendar-events.json.

Backend selection (`NEXT_EVENT_CLI`):
  gws   — Google Workspace CLI (default when installed)
  gog   — gog CLI
  auto  — gws if on PATH, otherwise gog (default)
A one-line `cli` file in the profile directory also pins the backend.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timedelta, timezone
from pathlib import Path

BACKEND_GWS = "gws"
BACKEND_GOG = "gog"
BACKEND_AUTO = "auto"

PROFILE_DIR = os.environ.get(
    "NEXT_EVENT_PROFILE",
    os.path.expanduser("~/.config/gws-omarchy-calendar")
)
TARGET_PATH = Path(
    os.environ.get(
        "NEXT_EVENT_STATE_FILE",
        os.path.expanduser("~/.local/state/omarchy/calendar-events.json")
    )
)

MEET_REGEX = re.compile(r"https://meet\.google\.com/[a-z0-9][a-z0-9-]+")

# Sync contract: the responseStatus value that means the user declined;
# must match RESPONSE_STATUS_DECLINED in Model.js.
RESPONSE_STATUS_DECLINED = "declined"

# Lookahead / lookbehind window for fetched events.
FETCH_DAYS_PAST = 2
FETCH_DAYS_AHEAD = 30

# Maximum events per calendar request.
MAX_RESULTS_PER_CALENDAR = 250

# Default calendar color when the API returns none.
DEFAULT_CALENDAR_COLOR = "#039be5"


def find_meet_url(*texts):
    for text in texts:
        if not text:
            continue
        m = MEET_REGEX.search(str(text))
        if m:
            return m.group(0)
    return ""


def resolve_video_link(gevent):
    direct = gevent.get("hangoutLink")
    if direct and direct.startswith("https://"):
        return direct.strip()

    conference = gevent.get("conferenceData") or {}
    for entry in conference.get("entryPoints") or []:
        if entry.get("entryPointType") == "video":
            uri = entry.get("uri")
            if uri and uri.startswith("https://"):
                return uri.strip()

    return find_meet_url(
        gevent.get("location"),
        gevent.get("description"),
        gevent.get("hangoutLink")
    )


def extract_response_status(gevent):
    for attendee in gevent.get("attendees") or []:
        if attendee.get("self"):
            return str(attendee.get("responseStatus") or "")
    return ""


def write_atomic(path: Path, doc: dict):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_path = tempfile.mkstemp(dir=str(path.parent), prefix="cal-events-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(doc, f, ensure_ascii=False, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp_path, path)
    except Exception:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)
        raise


def parse_collection(stdout, *keys):
    """Unwrap a JSON list from a CLI envelope (`items`, `calendars`, `events`) or a bare list."""
    try:
        data = json.loads(stdout)
    except Exception as e:
        preview = (stdout or "")[:200]
        raise RuntimeError(f"Failed to parse JSON: {e}\nOutput was: {preview}") from e

    if isinstance(data, list):
        return data
    if isinstance(data, dict):
        for key in keys:
            value = data.get(key)
            if isinstance(value, list):
                return value
    expected = ", ".join(keys) if keys else "a list"
    raise RuntimeError(f"Unexpected JSON shape; expected {expected} or a list")


def pinned_backend(profile_dir):
    cfg_file = Path(profile_dir) / "cli"
    if not cfg_file.is_file():
        return ""
    try:
        return cfg_file.read_text(encoding="utf-8").strip().lower()
    except Exception:
        return ""


def _require_backend(name):
    if not shutil.which(name):
        raise RuntimeError(
            f"Google Calendar CLI '{name}' is selected but is not on PATH."
        )
    return name


def resolve_backend(profile_dir=PROFILE_DIR):
    """Pick gws or gog.

    Precedence: NEXT_EVENT_CLI=gws|gog, then $PROFILE/cli, then auto
    (gws if installed, otherwise gog). NEXT_EVENT_CLI=auto falls through
    to the profile pin so installing gws later does not steal a gog setup.
    """
    env_cli = os.environ.get("NEXT_EVENT_CLI", "").strip().lower()
    file_cli = pinned_backend(profile_dir)

    if env_cli in (BACKEND_GWS, BACKEND_GOG):
        return _require_backend(env_cli)
    if file_cli in (BACKEND_GWS, BACKEND_GOG):
        return _require_backend(file_cli)

    leftover = env_cli or file_cli
    if leftover not in (BACKEND_AUTO, ""):
        raise RuntimeError(
            f"Unknown Google CLI {leftover!r}. Use gws, gog, or auto."
        )

    if shutil.which(BACKEND_GWS):
        return BACKEND_GWS
    if shutil.which(BACKEND_GOG):
        return BACKEND_GOG

    raise RuntimeError(
        "Neither 'gws' nor 'gog' is on PATH. "
        "Install the default CLI with: npm install -g @googleworkspace/cli "
        "Or use gog (https://github.com/openclaw/gogcli) and set NEXT_EVENT_CLI=gog."
    )


def run_cmd(bin_path, args, env=None):
    merged = dict(os.environ)
    if env:
        merged.update(env)
    res = subprocess.run([bin_path, *args], env=merged, capture_output=True, text=True)
    return res.returncode, res.stdout, res.stderr


def run_gws_cmd(args, profile_dir, gws_bin):
    return run_cmd(gws_bin, args, env={"GOOGLE_WORKSPACE_CLI_CONFIG_DIR": profile_dir})


def run_gog_cmd(args, gog_bin):
    cmd_args = []
    account = os.environ.get("NEXT_EVENT_GOG_ACCOUNT", "").strip()
    if account:
        cmd_args.extend(["--account", account])
    cmd_args.extend(args)
    return run_cmd(gog_bin, cmd_args)


def check_gws(gws_bin, profile_dir):
    code, _out, err = run_gws_cmd(["--version"], profile_dir=profile_dir, gws_bin=gws_bin)
    if code != 0:
        raise RuntimeError(f"gws not available or failed: {err}")


def check_gog(gog_bin):
    code, _out, err = run_gog_cmd(["--version"], gog_bin)
    if code != 0:
        raise RuntimeError(f"gog not available or failed: {err.strip() or f'exit {code}'}")


def gog_auth_error(code, err):
    message = (err or "").strip() or f"gog exited {code}"
    if code == 4:
        return (
            "gog is not authenticated (exit 4). "
            "Run `gog auth setup` and `gog auth add <email>`, "
            f"then retry. {message}"
        )
    return message


def list_calendars_gws(profile_dir, gws_bin):
    code, out, err = run_gws_cmd(
        ["calendar", "calendarList", "list"],
        profile_dir=profile_dir,
        gws_bin=gws_bin
    )
    if code != 0:
        raise RuntimeError(err.strip())
    calendars = parse_collection(out, "items")
    if not calendars:
        calendars = [{"id": "primary", "summary": "Primary", "backgroundColor": DEFAULT_CALENDAR_COLOR}]
    return calendars


def list_calendars_gog(gog_bin):
    code, out, err = run_gog_cmd(
        ["calendar", "calendars", "--json", "--no-input", "--all"],
        gog_bin,
    )
    if code != 0:
        raise RuntimeError(gog_auth_error(code, err))
    calendars = parse_collection(out, "calendars", "items")
    if not calendars:
        calendars = [{"id": "primary", "summary": "Primary", "backgroundColor": DEFAULT_CALENDAR_COLOR}]
    return calendars


def fetch_events_gws(cal_id, time_min, time_max, profile_dir, gws_bin):
    params = json.dumps({
        "calendarId": cal_id,
        "singleEvents": True,
        "orderBy": "startTime",
        "timeMin": time_min,
        "timeMax": time_max,
        "maxResults": MAX_RESULTS_PER_CALENDAR
    })
    code, out, err = run_gws_cmd(
        ["calendar", "events", "list", "--params", params],
        profile_dir=profile_dir,
        gws_bin=gws_bin
    )
    if code != 0:
        print(f"Warning: skipping calendar {cal_id}: {err.strip()}", file=sys.stderr)
        return None
    try:
        return parse_collection(out, "items")
    except Exception as exc:
        print(f"Warning: could not parse events for calendar {cal_id}: {exc}", file=sys.stderr)
        return None


def fetch_events_gog(cal_id, time_min, time_max, gog_bin):
    code, out, err = run_gog_cmd(
        [
            "calendar", "events",
            "--json", "--no-input",
            "--cal", cal_id,
            "--from", time_min,
            "--to", time_max,
            "--max", str(MAX_RESULTS_PER_CALENDAR),
            "--all-pages",
            "--sort", "start",
        ],
        gog_bin,
    )
    if code != 0:
        print(f"Warning: skipping calendar {cal_id}: {gog_auth_error(code, err)}", file=sys.stderr)
        return None
    try:
        return parse_collection(out, "events", "items")
    except Exception as exc:
        print(f"Warning: could not parse events for calendar {cal_id}: {exc}", file=sys.stderr)
        return None


def normalize_event(g_ev, cal_id, cal_name, cal_color):
    """Convert a raw Google Calendar event dict to the Omarchy contract shape."""
    start_obj = g_ev.get("start") or {}
    end_obj = g_ev.get("end") or {}

    start_str = start_obj.get("dateTime") or start_obj.get("date") or ""
    end_str = end_obj.get("dateTime") or end_obj.get("date") or ""
    if not start_str:
        return None

    all_day = "date" in start_obj and "dateTime" not in start_obj
    date_key = start_str[:10] if len(start_str) >= 10 else ""

    return {
        "id": g_ev.get("id") or "",
        "calendarId": cal_id,
        "calendarName": cal_name,
        "color": cal_color,
        "dateKey": date_key,
        "start": start_str,
        "end": end_str,
        "allDay": all_day,
        "title": g_ev.get("summary") or "(Untitled)",
        "location": g_ev.get("location") or "",
        "description": g_ev.get("description") or "",
        "meetingUrl": resolve_video_link(g_ev),
        "eventUrl": g_ev.get("htmlLink") or "",
        "eventType": g_ev.get("eventType") or "default",
        "responseStatus": extract_response_status(g_ev)
    }


def get_calendar_filter(profile_dir):
    env_val = os.environ.get("NEXT_EVENT_CALENDARS", "").strip()
    if env_val:
        return [c.strip().lower() for c in env_val.split(",") if c.strip()]

    cfg_file = Path(profile_dir) / "calendars.txt"
    if cfg_file.is_file():
        try:
            lines = cfg_file.read_text(encoding="utf-8").splitlines()
            return [line.strip().lower() for line in lines if line.strip() and not line.startswith("#")]
        except Exception:
            pass
    return []


def calendar_matches_filter(cal, cal_filter):
    if not cal_filter:
        return True
    cal_id = str(cal.get("id") or "")
    cal_summary = str(cal.get("summary") or "")
    for needle in cal_filter:
        if needle == "primary" and cal.get("primary"):
            return True
        if needle in cal_id.lower() or needle in cal_summary.lower():
            return True
    return False


def collect_events(calendars, time_min, time_max, fetch_items):
    cal_filter = get_calendar_filter(PROFILE_DIR)
    all_events = []

    for cal in calendars:
        cal_id = cal.get("id", "")
        if not cal_id:
            continue
        if cal.get("selected") is False:
            continue
        if not calendar_matches_filter(cal, cal_filter):
            continue

        cal_name = cal.get("summary") or cal_id
        cal_color = cal.get("backgroundColor") or DEFAULT_CALENDAR_COLOR

        items = fetch_items(cal_id, time_min, time_max)
        if items is None:
            continue

        for g_ev in items:
            if g_ev.get("status") == "cancelled":
                continue
            ev = normalize_event(g_ev, cal_id, cal_name, cal_color)
            if ev is not None:
                all_events.append(ev)

    all_events.sort(key=lambda e: e.get("start", ""))
    return all_events


def write_events(events, source, now):
    doc = {
        "version": 1,
        "syncedAt": now.isoformat(),
        "source": source,
        "events": events
    }
    write_atomic(TARGET_PATH, doc)
    print(f"Synced {len(events)} events into {TARGET_PATH} ({source})")
    return len(events)


def fetch_via_gws(profile_dir=PROFILE_DIR):
    gws_bin = shutil.which("gws") or "gws"
    check_gws(gws_bin, profile_dir)
    calendars = list_calendars_gws(profile_dir, gws_bin)

    now = datetime.now(timezone.utc)
    time_min = (now - timedelta(days=FETCH_DAYS_PAST)).isoformat()
    time_max = (now + timedelta(days=FETCH_DAYS_AHEAD)).isoformat()

    events = collect_events(
        calendars,
        time_min,
        time_max,
        lambda cal_id, tmin, tmax: fetch_events_gws(cal_id, tmin, tmax, profile_dir, gws_bin),
    )
    return write_events(events, "google-workspace", now)


def fetch_via_gog(profile_dir=PROFILE_DIR):
    gog_bin = shutil.which("gog") or "gog"
    check_gog(gog_bin)
    calendars = list_calendars_gog(gog_bin)

    now = datetime.now(timezone.utc)
    time_min = (now - timedelta(days=FETCH_DAYS_PAST)).strftime("%Y-%m-%dT%H:%M:%SZ")
    time_max = (now + timedelta(days=FETCH_DAYS_AHEAD)).strftime("%Y-%m-%dT%H:%M:%SZ")

    events = collect_events(
        calendars,
        time_min,
        time_max,
        lambda cal_id, tmin, tmax: fetch_events_gog(cal_id, tmin, tmax, gog_bin),
    )
    return write_events(events, "gog", now)


def main():
    try:
        backend = resolve_backend()
        if backend == BACKEND_GOG:
            fetch_via_gog()
        else:
            fetch_via_gws()
        sys.exit(0)
    except Exception as e:
        print(f"Sync error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
